<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nuway_bringup</name>
  <version>0.0.0</version>
  <description>stack.launch.py, the one launch file: reads a profile YAML (docs/02 §5) and includes the per-subsystem launches.</description>
  <maintainer email="peryaudo@gmail.com">Tetsui Ohkubo</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nuway_carla_bridge</exec_depend>
  <exec_depend>nuway_map</exec_depend>
  <exec_depend>nuway_route</exec_depend>
  <exec_depend>nuway_localization</exec_depend>
  <exec_depend>nuway_perception</exec_depend>
  <exec_depend>nuway_control</exec_depend>
  <exec_depend>nuway_viz</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
