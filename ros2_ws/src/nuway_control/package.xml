<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nuway_control</name>
  <version>0.0.0</version>
  <description>Vehicle model (LongitudinalMap from the sysid YAML), pure pursuit + PID controller and its node (M0); mpc_node (M1).</description>
  <maintainer email="peryaudo@gmail.com">Tetsui Ohkubo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>nuway_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>rclcpp</depend>
  <depend>nuway_common</depend>
  <depend>nuway_msgs</depend>
  <depend>osqp_eigen_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
