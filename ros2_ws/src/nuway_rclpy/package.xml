<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nuway_rclpy</name>
  <version>0.0.0</version>
  <description>rclpy-side helpers shared by the Python node packages (M0): QoS profiles from the docs/02 table and geometry &lt;-&gt; message conversions.</description>
  <maintainer email="peryaudo@gmail.com">Tetsui Ohkubo</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
