<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nuway_route</name>
  <version>0.0.0</version>
  <description>Multi-waypoint A* on the lane graph, reference line builder, route_planner_node (M0).</description>
  <maintainer email="peryaudo@gmail.com">Tetsui Ohkubo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>nuway_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>nuway_common</depend>
  <depend>nuway_map</depend>
  <depend>nuway_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
